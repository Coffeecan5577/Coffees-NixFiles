Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

frame_count = FRAME_COUNT_PLACEHOLDER;

// Original frames are 1920x1080 (16:9)
original_width = 1920;
original_height = 1080;

// Current layout. Recomputed whenever the display size changes, because
// Plymouth can start on a small firmware framebuffer and switch to the
// native resolution later in boot.
cur_w = 0;
cur_h = 0;
final_width = original_width;
final_height = original_height;
pos_x = 0;
pos_y = 0;
layout_id = 1;

// Load every frame once at its original size. Scaled copies are made on
// demand, and remade whenever the layout changes.
// ffmpeg outputs frame-1.png, frame-2.png ... (1-indexed)
for (i = 0; i < frame_count; i++) {
  raw_image[i] = Image("frame-" + (i + 1) + ".png");
 // scaled image must be created here, at the top level, so it is global.
 // If it were first assigned inside refresh_callback it would be local
 // and the cache would be thrown away on every call.
  scaled_image[i] = raw_image[i];
  scaled_for[i] = 0;
}

anim_sprite = Sprite(raw_image[0]);
anim_sprite.SetZ(0);

progress = 0;

// Global sprite references — must be global or Plymouth's GC destroys them instantly
mode_sprite = null;
prompt_sprite = null;
bullets = null;
msg_sprite = null;
ok_sprite = null;
debug_sprite = null;
bullet_img = Image.Text("*", 1, 1, 1);
password_field_active = 0;
password_error = 0;

// ── Boot / shutdown mode label ────────────────────────────
fun update_mode_label() {
  sw = Window.GetWidth();
  sh = Window.GetHeight();
  if (sw == 0) return;

  mode = Plymouth.GetMode();
  if (mode == "shutdown")
    mode_text = "Shutting down...";
  else if (mode == "reboot")
    mode_text = "Rebooting...";
  else
    mode_text = "Booting...";

  mode_img = Image.Text(mode_text, 0.7, 0.7, 0.7);
  mode_sprite = Sprite(mode_img);
  mode_sprite.SetX(sw - mode_img.GetWidth() - 40);
  mode_sprite.SetY(sh - mode_img.GetHeight() - 40);
  mode_sprite.SetZ(10);
}

// ── Layout: size the animation to the largest connected display ──
fun update_layout() {
  lw = 0;
  lh = 0;
  for (ld = 0; ld < 4; ld++) {
    t_w = Window.GetWidth(ld);
    t_h = Window.GetHeight(ld);
    if (t_w > lw) lw = t_w;
    if (t_h > lh) lh = t_h;
  }
  // Fallback if the per-display lookup returned nothing
  if (lw == 0) {
    lw = Window.GetWidth();
    lh = Window.GetHeight();
  }
  if (lw == 0) return;
  if (lw == cur_w && lh == cur_h) return;

  cur_w = lw;
  cur_h = lh;

  // Scale to fill the screen (crop edges if needed, no distortion)
  fit = Math.Max(lw / original_width, lh / original_height);
  final_width = Math.Int(original_width * fit);
  final_height = Math.Int(original_height * fit);

  // Center the animation
  pos_x = (lw - final_width) / 2;
  pos_y = (lh - final_height) / 2;

  // Invalidates every cached scaled frame
  layout_id++;

  // Re-place the Booting/Shutting down label for the new size
  update_mode_label();
}

// Playback speed: a new frame every 4 refresh ticks. Lower = faster.
fun refresh_callback() {
  update_layout();

  frame = Math.Int(progress / 3) % frame_count;
  if (scaled_for[frame] != layout_id) {
    scaled_image[frame] = raw_image[frame].Scale(final_width, final_height);
    scaled_for[frame] = layout_id;
  }

  anim_sprite.SetImage(scaled_image[frame]);
  anim_sprite.SetX(pos_x);
  anim_sprite.SetY(pos_y);
  progress++;
}

Plymouth.SetRefreshFunction(refresh_callback);

// ── LUKS / password prompt ───────────────────────────────
fun DisplayPasswordCallback(nil, bulletCount) {
  password_field_active = 1;
  password_error = 0;
  sw = Window.GetWidth();
  sh = Window.GetHeight();

  prompt_img = Image.Text("Enter Password:", 1, 1, 1);
  prompt_sprite = Sprite(prompt_img);
  prompt_sprite.SetX(sw / 2 - prompt_img.GetWidth() / 2);
  prompt_sprite.SetY(sh * 0.94);
  prompt_sprite.SetZ(10);

  bullets = null;
  total = bulletCount * bullet_img.GetWidth();
  bx = sw / 2 - total / 2;
  for (i = 0; i < bulletCount; i++) {
    bullets[i] = Sprite(bullet_img);
    bullets[i].SetX(bx + i * bullet_img.GetWidth());
    bullets[i].SetY(sh * 0.94 + prompt_img.GetHeight() + 4);
    bullets[i].SetZ(10);
  }
}
Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);

fun DisplayNormalCallback() {
  prompt_sprite = null;
  bullets = null;
  msg_sprite = null;
  ok_sprite = null;
  password_field_active = 0;
  password_error = 0;
}
Plymouth.SetDisplayNormalFunction(DisplayNormalCallback);

// ── Message callback: amber status messages ───────────────
fun MessageCallback(text) {
  sw = Window.GetWidth();
  sh = Window.GetHeight();

  is_error = (text == "Password incorrect") || (text == "Authentication failure") || (text == "Login failed");

  if (is_error) {
    msg_img = Image.Text(text, 1, 0.2, 0.2);
    password_error = 1;
  } else
    msg_img = Image.Text(text, 1, 0.75, 0.2);

  msg_sprite = Sprite(msg_img);
  msg_sprite.SetX(sw - msg_img.GetWidth() - 40);
  msg_sprite.SetY(sh - msg_img.GetHeight() - 80);
  msg_sprite.SetZ(11);
}
Plymouth.SetMessageFunction(MessageCallback);

// Initial layout (also draws the Booting/Shutting down label)
update_layout();
